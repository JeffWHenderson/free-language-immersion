          "Soy",
          "am"
        ],
        [
          "estudiante",
          "student"
        ]
      ],
      "format": "table",
      "table": {
        "title": "ser — the subject pronoun is optional",
        "rows": [
          [
            "(yo) soy",
            "I am"
          ],
          [
            "(tú) eres",
            "you are"
          ],
          [
            "(él/ella) es",
            "he/she is"
          ],
          [
            "(nosotros) somos",
            "we are"
          ],
          [
            "(ellos) son",
            "they are"
          ]
